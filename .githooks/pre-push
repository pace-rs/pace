#!/bin/sh
# codegate: every gate, the slow ones too, before each push.
# `codegate init` wrote this hook; `codegate setup` makes git run it.
if ! command -v codegate >/dev/null 2>&1; then
    echo "pre-push: skipped codegate's gates: codegate is not on the PATH" >&2
    echo "pre-push: the push goes on unchecked; put codegate on the PATH and run \`codegate check --full\`" >&2
    exit 0
fi
exec codegate check --full
