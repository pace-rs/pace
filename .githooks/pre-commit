#!/bin/sh
# codegate's fast gates before each commit (`.config/codegate.toml`);
# `just gate` runs the slow ones too.
if ! command -v codegate >/dev/null 2>&1; then
    echo "pre-commit: skipped codegate's gates: codegate is not on the PATH" >&2
    echo "pre-commit: the commit goes on unchecked; put codegate on the PATH and run \`codegate check\`" >&2
    exit 0
fi
exec codegate check
