{#- The report of `pace reflect --format markdown`: a table per part. It
    receives the JSON document of the schema, version 1: `version`, `kind`
    and `rows`. A `*` marks time that counts a running entry. -#}
{%- component change(row, kind) -%}
{%- if row.previous %} (was {{ row.previous[kind] | default(value="none") }}{% if kind == "amount" %} {{ row.previous.currency }}{% endif %}, {% if kind == "net" %}{{ row.change_net }}{% elif kind == "held" %}{{ row.change_held }}{% elif kind == "paused" %}{{ row.change_paused }}{% else %}{{ row.change_amount }}{% endif %}{% if row.change_percent is defined %}, {% if row.change_percent > 0 %}+{% endif %}{{ row.change_percent }}%{% endif %}){% endif -%}
{%- endcomponent change -%}
{%- component highlight(row) -%}
{%- if row.group == "busiest_day" %}Busiest day: {{ row.date | default(value="none") }}{% if row.net %}, {{ row.net }}{% if row.running %}*{% endif %}{% endif %}; in the previous period {% if row.previous %}{{ row.previous.date | default(value="none") }}{% if row.previous.net %}, {{ row.previous.net }}{% endif %}{% else %}none{% endif %}
{%- else %}Top project: {{ row.name | default(value=row.key | default(value="none")) }}{% if row.net %}, {{ row.net }}{% if row.running %}*{% endif %}{% endif %}; in the previous period {% if row.previous %}{{ row.previous.name | default(value=row.previous.key | default(value="none")) }}{% if row.previous.net %}, {{ row.previous.net }}{% endif %}{% else %}none{% endif %}
{%- endif -%}
{%- endcomponent highlight -%}
{%- set parts = rows | group_by(attribute="part") -%}
{%- set time = parts.time | default(value=[]) | group_by(attribute="group") -%}
{%- set tracked = time.tracked | default(value=[]) | first -%}
{%- set untracked = time.untracked | default(value=[]) | first -%}
{%- set days = time.day | default(value=[]) -%}
{%- set_global marked = false -%}
{%- for row in rows -%}{%- if row.running -%}{%- set_global marked = true -%}{%- endif -%}{%- endfor -%}
{%- if days -%}
{%- set first_day = days | first -%}
{%- set last_day = days | last -%}
{%- if first_day.date == last_day.date -%}
# Report for {{ first_day.date }}
{% else -%}
# Report from {{ first_day.date }} to {{ last_day.date }}
{% endif -%}
{%- else -%}
# Report
{% endif -%}
{%- if not tracked or tracked.net_seconds == 0 %}
Nothing tracked.
{% else %}
Tracked {{ tracked.net }}{{ <change row={tracked} kind="net"/> }}, untracked {{ untracked.net }}{{ <change row={untracked} kind="net"/> }}.
{% if parts.highlights %}
## Highlights

{% for row in parts.highlights -%}
- {{ <highlight row={row}/> }}.
{% endfor -%}
{% endif %}
## Time per role

| Role | Time | Share |
| ---- | ---: | ----: |
{% for row in time.role | default(value=[]) -%}
| {{ row.name | default(value="No role") | replace(from="|", to="&#124;") }} | {{ row.net }}{% if row.running %}*{% endif %}{{ <change row={row} kind="net"/> }} | {{ row.percent }}% |
{% endfor %}
## Time per project

| Project | Time | Share |
| ------- | ---: | ----: |
{% for row in time.project | default(value=[]) -%}
| {{ row.name | default(value=row.key | default(value="No project")) | replace(from="|", to="&#124;") }} | {{ row.net }}{% if row.running %}*{% endif %}{{ <change row={row} kind="net"/> }} | {{ row.percent }}% |
{% endfor %}
## Time per day

| Day | Time | Share |
| --- | ---: | ----: |
{% for row in days -%}
| {{ row.date }} | {% if row.net_seconds == 0 %}–{% else %}{{ row.net }}{% if row.running %}*{% endif %}{% endif %} | {% if row.net_seconds > 0 %}{{ row.percent }}%{% endif %} |
{% endfor -%}
{%- set target = parts.target | default(value=[]) | group_by(attribute="group") -%}
{%- if target %}
## Target vs. actual
{% for row in target.targets_above_week | default(value=[]) %}
The weekly targets add up to {{ row.target }}, more than the 168h of a week.
{% endfor -%}
{%- if target.role %}
| Role | Time | Target | Share |
| ---- | ---: | -----: | ----: |
{% for row in target.role -%}
| {{ row.name | default(value=row.id) | replace(from="|", to="&#124;") }} | {{ row.net }}{% if row.running %}*{% endif %}{{ <change row={row} kind="net"/> }} | {{ row.target }} | {{ row.percent }}% |
{% endfor -%}
{%- endif -%}
{%- endif -%}
{%- if parts.budget %}
## Budgets, used to date

| Project | Used | Budget | Share |
| ------- | ---: | -----: | ----: |
{% for row in parts.budget -%}
| {{ row.name | default(value=row.key) | replace(from="|", to="&#124;") }} | {{ row.net }}{% if row.running %}*{% endif %} | {{ row.budget }} | {{ row.percent }}% |
{% endfor -%}
{%- endif -%}
{%- set revenue = parts.revenue | default(value=[]) | group_by(attribute="group") -%}
{%- if revenue %}
## Revenue
{% if revenue.client %}
| Client and project | Billed | Amount |
| ------------------ | -----: | -----: |
{% for client in revenue.client -%}
| {{ client.name | replace(from="|", to="&#124;") }} | {{ client.billed }}{% if client.running %}*{% endif %} | {{ client.amount }} {{ client.currency }}{{ <change row={client} kind="amount"/> }} |
{% for row in revenue.project | default(value=[]) -%}
{%- if row.client == client.key and row.currency == client.currency %}| – {{ row.name | default(value=row.key) | replace(from="|", to="&#124;") }} | {{ row.billed }}{% if row.running %}*{% endif %} | {{ row.amount }} {{ row.currency }}{{ <change row={row} kind="amount"/> }} |
{% endif -%}
{%- endfor -%}
{%- endfor -%}
{%- for row in revenue.total | default(value=[]) -%}
| **Total** | | **{{ row.amount }} {{ row.currency }}{{ <change row={row} kind="amount"/> }}** |
{% endfor -%}
{%- endif -%}
{%- for row in revenue.no_rate | default(value=[]) %}
No rate on {{ row.date }} for {{ row.net }} of {{ row.name | default(value=row.key) }}; `pace client edit {{ row.client }}` gives it a rate.
{% endfor -%}
{%- endif -%}
{%- set holds = parts.interruptions | default(value=[]) | group_by(attribute="group") -%}
{%- if holds %}
## Interruptions
{% for total in holds.total | default(value=[]) %}
{{ total.count }} hold{{ total.count | pluralize }}, {{ total.held }}:
{%- for row in holds.source | default(value=[]) %} {{ row.key }} {{ row.count }}{% if row.count > 0 %} ({{ row.held }}){% endif %}{% if loop.last %}.{% else %},{% endif %}{% endfor %}
{% endfor -%}
{%- if holds.reason %}
Most frequent reasons: {% for row in holds.reason %}{{ row.reason }} {{ row.count }}{% if not loop.last %}, {% endif %}{% endfor %}.
{% endif -%}
{%- for total in holds.total | default(value=[]) -%}{%- if total.previous %}
Previous period: {{ total.previous.count }} hold{{ total.previous.count | pluralize }}, {{ total.previous.held }}:{%- for row in holds.source | default(value=[]) %} {{ row.key }} {{ row.previous.count }}{% if row.previous.count > 0 %} ({{ row.previous.held }}){% endif %}{% if not loop.last %},{% endif %}{% endfor %}{% if holds.reason %}; reasons: {% for row in holds.reason %}{{ row.reason }} {{ row.previous.count }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}.
{% endif -%}{%- endfor -%}
{%- endif -%}
{%- set pauses = parts.pauses | default(value=[]) | group_by(attribute="group") -%}
{%- if pauses %}
## Pauses and catches
{% if pauses.kind %}
Pauses: {% for row in pauses.kind %}{{ row.key }} {{ row.count }} ({{ row.paused }}){% if not loop.last %}, {% endif %}{% endfor %}.
{% set first_kind = pauses.kind | first -%}
{%- if first_kind.previous %}
Previous period: {% for row in pauses.kind %}{{ row.key }} {{ row.previous.count }} ({{ row.previous.paused }}){% if not loop.last %}, {% endif %}{% endfor %}.
{% endif -%}
{% endif -%}
{%- if pauses.catch %}
{% for row in pauses.catch -%}
- Catch on {{ row.start[:10] }} at {{ row.start[11:16] }}: {{ row.note }}
{% endfor -%}
{%- endif -%}
{%- endif -%}
{%- if parts.decided %}
## Who decided

| Decided by | Time | Share |
| ---------- | ---: | ----: |
{% for row in parts.decided -%}
| {% if row.key == "self" %}Me{% elif row.key == "other" %}Others{% else %}Unmarked{% endif %} | {{ row.net }}{% if row.running %}*{% endif %}{{ <change row={row} kind="net"/> }} | {{ row.percent }}% |
{% endfor -%}
{%- endif -%}
{%- if parts.overlaps %}
## Overlaps

{% for row in parts.overlaps -%}
- {{ row.short }} and {{ row.other_short }} both cover {{ row.start[:10] }} {{ row.start[11:16] }} to {{ row.end[:10] }} {{ row.end[11:16] }}; change one with `pace adjust <id>`.
{% endfor -%}
{%- endif -%}
{%- if marked %}
`*` counts a running entry up to now.
{% endif -%}
{%- endif -%}
